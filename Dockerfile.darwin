ARG TARGET=aarch64-apple-darwin

# Pin by digest to prevent supply-chain tag-swap attacks.
# Renovate will auto-update this digest when new versions are published.
FROM ghcr.io/rust-cross/cargo-zigbuild:latest@sha256:dce4ea213244423439d97a2070031c6ea287fc32f01b0aaa38f8b4d46f52e68c AS builder
ARG TARGET

RUN rustup target add "$TARGET"

WORKDIR /src
COPY . .

# Reserve Mach-O header space so the release signer can insert LC_CODE_SIGNATURE
# in place. zig emits an ad-hoc signature only for arm64, which Apple Silicon
# requires to exec; the x86_64 output has none, and only 8 of the 16 bytes of
# header slack that adding the load command needs.
ENV RUSTFLAGS="-C link-arg=-Wl,-headerpad,0x1000"

# strip=false: Rust's built-in strip corrupts aarch64-apple-darwin binaries
# when cross-compiled via zigbuild (https://github.com/rust-cross/cargo-zigbuild/issues/50).
# Only arm64 needs it; unconditional so both Apple targets share one Dockerfile.
RUN cargo zigbuild --release --target "$TARGET" \
    --config profile.release.strip=false

FROM scratch
ARG TARGET
COPY --from=builder /src/target/${TARGET}/release/bx /bx
